# package-lock.json
# yarn.lock

# =============================
# Framework Specific
# =============================

# Vite / React build output
Admin/dist/
Frontend_Improved/dist/

# Backend uploads or generated files
Backend/uploads/
Backend/tmp/
Backend/.env

# Ignore local test or temp files
*.local
*.tmp
*.bak

# =============================
# Git
# =============================

# Ignore gitignore itself (redundant but safe)
!.gitignore
